# ─────────────────────────────────────────────────────────────
# Quantum Vault — Backend environment configuration
# Copy this file to  app/backend/.env  and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Demo / Review mode ──────────────────────────────────────
# Set to true to run without a real QPU (deterministic fixture output).
# All output will be labeled REVIEW DEMO / NO LIVE QPU.
QUANTUM_REVIEW_DEMO=false

# ── IQM Quantum (preferred hardware provider) ────────────────
# 1. Create an account at https://resonance.iqm.tech
# 2. Generate an access token on the Resonance dashboard.
IQM_SERVER_URL=
IQM_ACCESS_TOKEN=
IQM_REFRESH_TOKEN=
IQM_QUANTUM_COMPUTER=sirius
IQM_QUBIT=

# Optional OAuth / Cortex token refresh
IQM_AUTH_SERVER_URL=
IQM_AUTH_TOKEN_URL=
IQM_AUTH_REALM=cortex
IQM_AUTH_CLIENT_ID=iqm_client
IQM_AUTH_CLIENT_SECRET=

# ── IBM Quantum (alternative hardware provider) ──────────────
# Used only when IQM variables above are NOT configured.
# 1. Create a free account: https://quantum.cloud.ibm.com
# 2. Go to "API tokens" and generate a token.
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
IBM_QUANTUM_BACKEND=

# ── Lab limits ───────────────────────────────────────────────
QRNG_MIN_SHOTS=8
QRNG_MAX_SHOTS=4096
QRNG_DEFAULT_SHOTS=256
QRNG_JOB_TIMEOUT_SECONDS=3600
QRNG_SUBMIT_COOLDOWN_SECONDS=13
PRNG_MAX_BITS=8192
PRNG_DEFAULT_BITS=256

# ── Storage ──────────────────────────────────────────────────
QRLAB_DATA_DIR=./data
