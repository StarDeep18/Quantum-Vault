# ─────────────────────────────────────────────────────────────
# Quantum Randomness Lab — environment configuration
# Copy to  app/backend/.env  (or the repo root .env) and fill in.
# NEVER commit the real .env. Credentials stay server-side only.
# ─────────────────────────────────────────────────────────────

# ── Temporary review presentation mode ─────────────────────────
# OFF by default. When explicitly enabled, the frontend demonstrates
# the same key/vault flow with a deterministic fixture. No QPU job is
# submitted, and all output is visibly labeled REVIEW DEMO / NO LIVE QPU.
QUANTUM_REVIEW_DEMO=false
# Optional frontend-only override/fallback (Vite build-time variable).
# Do not enable for a production build.
VITE_QUANTUM_REVIEW_DEMO=false

# ── IQM Quantum (PREFERRED hardware provider when configured) ─
# 1. Create an account at https://resonance.iqm.tech (or use
#    your on-prem IQM server).
# 2. Get an access token: generate one on the Resonance dashboard
#    (long-lived), or run `cortex auth login` for an access +
#    refresh token pair.
# 3. Set the IQM server URL. For IQM Resonance (current form):
#    https://resonance.iqm.tech
#    The quantum computers your account can use (e.g. emerald,
#    garnet, sirius) are discovered live by the backend.
IQM_SERVER_URL=
IQM_ACCESS_TOKEN=

# Optional: refresh token (Cortex / OAuth tokens only). When set,
# the backend refreshes the access token server-side automatically.
# Never exposed to the frontend, never logged.
IQM_REFRESH_TOKEN=

# Pin this vault configuration to the requested IQM QPU. The backend
# validates the alias through live discovery and fails closed if absent.
IQM_QUANTUM_COMPUTER=sirius

# Optional: pin a specific qubit name from the live architecture.
# Leave empty = first qubit of the live QPU architecture (real
# names only — the backend never invents qubit names).
IQM_QUBIT=

# Optional: token refresh endpoint — needed ONLY when you use an
# access+refresh token pair. Two supported flows:
#   Cortex CLI (Keycloak):    set IQM_AUTH_SERVER_URL (the auth
#     server base URL from your cortex config.json); realm defaults
#     to "cortex", client id to "iqm_client".
#   IQM user-management OAuth: set IQM_AUTH_TOKEN_URL to the full
#     token endpoint (e.g. https://api.iqm.com/api/v3/ua/oauth/token)
#     and, if your flow requires it, IQM_AUTH_CLIENT_ID +
#     IQM_AUTH_CLIENT_SECRET.
IQM_AUTH_SERVER_URL=
IQM_AUTH_TOKEN_URL=
IQM_AUTH_REALM=cortex
IQM_AUTH_CLIENT_ID=iqm_client
IQM_AUTH_CLIENT_SECRET=

# ── IBM Quantum (alternative hardware provider) ──────────────
# Used for hardware mode only when the IQM variables above are
# NOT configured.
# 1. Create a free account: https://quantum.cloud.ibm.com
# 2. Go to "API tokens" and generate a token.
IBM_QUANTUM_API_KEY=

# Optional: IBM Quantum Platform instance CRN. Leave empty to use
# your account's default instance.
IBM_QUANTUM_INSTANCE=

# IBM Quantum access channel. The current IBM Quantum Platform
# uses "ibm_quantum_platform".
IBM_QUANTUM_CHANNEL=ibm_quantum_platform

# Optional: pin a specific quantum backend (e.g. ibm_brisbane).
# Leave empty for AUTO = least-busy operational, non-simulator QPU.
IBM_QUANTUM_BACKEND=

# ── Lab limits ───────────────────────────────────────────────
QRNG_MIN_SHOTS=8
QRNG_MAX_SHOTS=4096
QRNG_DEFAULT_SHOTS=256
# Default 3600 seconds to allow real QPU queue time; timeout creates no key.
QRNG_JOB_TIMEOUT_SECONDS=3600
# Local cooldown between hardware submissions (IBM allows 5/min).
QRNG_SUBMIT_COOLDOWN_SECONDS=13
PRNG_MAX_BITS=8192
PRNG_DEFAULT_BITS=256

# ── Storage ──────────────────────────────────────────────────
# Where experiment records are persisted (JSONL). Relative to the
# backend working directory.
QRLAB_DATA_DIR=./data
